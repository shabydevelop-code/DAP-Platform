<Window x:Class="GuideMe.Instructor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GuideMe Instructor" Height="660" Width="920" MinWidth="740" MinHeight="520"
        WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize" SizeToContent="Manual" ShowInTaskbar="True"
        FlowDirection="LeftToRight"
        Background="#FFF3F6FA" FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#FF18263B"/>
    <SolidColorBrush x:Key="Muted" Color="#FF64748B"/>
    <SolidColorBrush x:Key="Line" Color="#FFE2E8F0"/>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#FFFFFFFF"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="#FFCBD5E1"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="11,9"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#FFF1F5F9"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="#FFD4DEE9"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="15,10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="MinHeight" Value="40"/>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.48"/>
          <Setter Property="Cursor" Value="Arrow"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#FF2458C6"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#FF2458C6"/>
    </Style>
    <Style x:Key="SectionCard" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="20"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Window.Resources>

  <Grid FlowDirection="RightToLeft">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="28,18">
      <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Width="42" Height="42" CornerRadius="12" Background="#FFE8F0FF" Margin="0,0,0,0">
          <TextBlock Text="G" Foreground="#FF2458C6" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
        </Border>
        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="GuideMe Instructor" FontSize="23" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
          <TextBlock Text="סביבת יצירה והקלטת מדריכים" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" Margin="20,18,20,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource SectionCard}" Padding="13">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="שלבי המדריך" Style="{StaticResource SectionTitle}"/>
            <TextBlock x:Name="StepCountLabel" Text="טרם נטען מדריך · 0 שלבים" Style="{StaticResource Hint}" Margin="0,5,0,0"/>
          </StackPanel>
          <TextBox Grid.Row="1" x:Name="StepSearch" Margin="0,14,0,10" Padding="9,8"
                   TextChanged="StepSearch_TextChanged" ToolTip="חיפוש לפי מספר או תוכן שלב"/>
          <ListBox Grid.Row="2" x:Name="StepsList" BorderThickness="0" Background="Transparent"
                   SelectionChanged="StepsList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="4,8">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#FF64748B" Margin="0,3,0,0"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="מדריכים קיימים · V5 · קריאה בלבד" Style="{StaticResource Hint}"/>
            <ComboBox x:Name="ExistingGuides" Margin="0,8,0,0" DisplayMemberPath="Name" MinHeight="32"/>
            <Button Content="טען מדריך נבחר" Click="LoadExistingGuide_Click" Margin="0,8,0,0" Padding="8,5" MinHeight="34"/>
            <TextBlock x:Name="DatabaseStatus" Style="{StaticResource Hint}" Margin="0,7,0,0"/>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource SectionCard}" Padding="16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0">
            <DockPanel LastChildFill="True">
              <Button DockPanel.Dock="Left" Content="העתק קוד חיבור" Click="CopyPairingToken_Click" Padding="9,5" MinHeight="30"/>
              <StackPanel>
                <TextBlock Text="מדריך והקלטה" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="מזהה מדריך · חיבור לתוסף · יצירת שלבים" Style="{StaticResource Hint}"/>
              </StackPanel>
            </DockPanel>
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="מזהה מדריך" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="GuideKey" Text="sampleapp-web-instructor" FlowDirection="LeftToRight" Padding="8,6"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="קוד חיבור מקומי" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="PairingToken" IsReadOnly="True" FlowDirection="LeftToRight" Padding="8,6"/>
              </StackPanel>
            </Grid>
          </StackPanel>
          <Border Grid.Row="1" Background="#FFF4F7FC" CornerRadius="8" Padding="12" Margin="0,14,0,12">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock x:Name="StateLabel" Text="מוכן לתחילת שלב 1" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="StatusDetail" Text="יש לחבר את התוסף כדי להתחיל." Style="{StaticResource Hint}" Margin="0,5,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="התחל שלב" IsEnabled="False" Click="StartStep_Click" Padding="10,7" Margin="0,0,7,0"/>
                <Button x:Name="EndButton" Content="סיים שלב" IsEnabled="False" Click="EndStep_Click" Padding="10,7"/>
              </StackPanel>
            </Grid>
          </Border>
          <TabControl Grid.Row="2" x:Name="StepDetailsTabs" Margin="0,0,0,0" BorderBrush="{StaticResource Line}" Background="White"
                      TabStripPlacement="Top">
            <TabItem Header="סקירה">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="10">
                  <DockPanel LastChildFill="True">
                    <Button x:Name="CopyReviewButton" DockPanel.Dock="Left" Content="העתק סקירה" IsEnabled="False" Click="CopyReview_Click" Padding="9,5" MinHeight="30"/>
                    <TextBlock x:Name="ReviewHeading" Text="סקירת השלב" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                  </DockPanel>
                  <TextBox x:Name="ReviewText" Text="בחר שלב מהרשימה או הקלט שלב חדש."
                           IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                           VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                           MinHeight="140" Padding="11" Margin="0,9,0,0" Background="#FFF8FAFC"/>
                  <TextBlock Text="הוראה למשתמש — טיוטת הקלטה" Style="{StaticResource SectionTitle}" Margin="0,16,0,5"/>
                  <TextBox x:Name="BubbleText" Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                           VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" IsEnabled="False"/>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
              <TabItem Header="מדריך"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Text="זהות המדריך, סדר השלבים, שיוך להקשרי אפליקציה וכללי זיהוי האפליקציה." TextWrapping="Wrap" Foreground="#FF475569" Margin="0,0,0,14"/><TextBlock Text="Guides · GuideSteps · GuideApplicationContexts · ApplicationContextMatchers" FontFamily="Consolas" FontSize="12" FlowDirection="LeftToRight" TextWrapping="Wrap"/><TextBox x:Name="GuideDetails" Text="לא נטען מדריך." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="12" Margin="0,12,0,0" MinHeight="130"/></StackPanel></ScrollViewer></TabItem>
              <TabItem Header="הוראות"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Text="טקסט ההנחיה, מיקום הבועית והגדרות ההצגה שלה. עריכת טיוטת הקלטה זמינה כרגע בלשונית סקירה בלבד." TextWrapping="Wrap" Foreground="#FF475569" Margin="0,0,0,14"/><TextBlock Text="StepBubbles" FontFamily="Consolas" FontSize="12" FlowDirection="LeftToRight" TextWrapping="Wrap"/><TextBox x:Name="BubbleDetails" Text="לא נטען מדריך." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="12" Margin="0,12,0,0" MinHeight="130"/></StackPanel></ScrollViewer></TabItem>
              <TabItem Header="פעולה"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Text="הפעולה הנדרשת מהמשתמש והקשר שלה לרכיב יעד, בנפרד מטקסט ההוראה." TextWrapping="Wrap" Foreground="#FF475569" Margin="0,0,0,14"/><TextBlock Text="StepInteractions · StepElementUsages" FontFamily="Consolas" FontSize="12" FlowDirection="LeftToRight" TextWrapping="Wrap"/><TextBox x:Name="InteractionDetails" Text="לא נטען מדריך." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="12" Margin="0,12,0,0" MinHeight="130"/></StackPanel></ScrollViewer></TabItem>
              <TabItem Header="רכיבים"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Text="הגדרות רכיבים לשימוש חוזר, אסטרטגיות איתור, עוגנים, מסגרות ותפקיד הרכיב בשלב." TextWrapping="Wrap" Foreground="#FF475569" Margin="0,0,0,14"/><TextBlock Text="GuideElements · ElementLocators · ElementAnchorRelations · StepElementUsages" FontFamily="Consolas" FontSize="12" FlowDirection="LeftToRight" TextWrapping="Wrap"/><TextBox x:Name="ElementDetails" Text="לא נטען מדריך." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="12" Margin="0,12,0,0" MinHeight="130"/></StackPanel></ScrollViewer></TabItem>
              <TabItem Header="אימות ומעבר"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Text="אותות האימות, ערכים צפויים ומדיניות המעבר לשלב הבא." TextWrapping="Wrap" Foreground="#FF475569" Margin="0,0,0,14"/><TextBlock Text="StepObservedSignals · StepAdvancePolicies" FontFamily="Consolas" FontSize="12" FlowDirection="LeftToRight" TextWrapping="Wrap"/><TextBox x:Name="ValidationDetails" Text="לא נטען מדריך." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="12" Margin="0,12,0,0" MinHeight="130"/></StackPanel></ScrollViewer></TabItem>
              <TabItem Header="תוצאה"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Text="התוצאה העסקית או התפעולית המצופה, בנפרד מאותות האימות הטכניים." TextWrapping="Wrap" Foreground="#FF475569" Margin="0,0,0,14"/><TextBlock Text="StepExpectedOutcomes" FontFamily="Consolas" FontSize="12" FlowDirection="LeftToRight" TextWrapping="Wrap"/><TextBox x:Name="OutcomeDetails" Text="לא נטען מדריך." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="12" Margin="0,12,0,0" MinHeight="130"/></StackPanel></ScrollViewer></TabItem>
              <TabItem Header="לכידות"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Text="הגדרות משתנים ולכידת ערכים במהלך ביצוע המדריך." TextWrapping="Wrap" Foreground="#FF475569" Margin="0,0,0,14"/><TextBlock Text="GuideVariables · StepCaptures" FontFamily="Consolas" FontSize="12" FlowDirection="LeftToRight" TextWrapping="Wrap"/><TextBox x:Name="CaptureDetails" Text="לא נטען מדריך." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="12" Margin="0,12,0,0" MinHeight="130"/></StackPanel></ScrollViewer></TabItem>
            <TabItem Header="אבחון">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">
                  <TextBlock Text="הקשר מסך — אבחון בלבד" FontWeight="SemiBold" Margin="0,0,0,12"/>
                  <TextBlock Text="ContextId" FontSize="11"/>
                  <TextBox x:Name="ContextIdText" IsReadOnly="True" FlowDirection="LeftToRight" IsEnabled="False"/>
                  <TextBlock Text="ContextKind" FontSize="11" Margin="0,9,0,0"/>
                  <TextBox x:Name="ContextKindText" IsReadOnly="True" FlowDirection="LeftToRight" IsEnabled="False"/>
                  <TextBlock Text="ContextValue" FontSize="11" Margin="0,9,0,0"/>
                  <TextBox x:Name="ContextValueText" IsReadOnly="True" FlowDirection="LeftToRight" IsEnabled="False"/>
                  <TextBlock Text="בהמשך: הצגת רשומות V5 גולמיות, מזהים וקשרים בין טבלאות, ללא עריכה ישירה." TextWrapping="Wrap" Foreground="#FF64748B" Margin="0,14,0,0"/>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
          </TabControl>
          <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <Button x:Name="ApproveButton" Style="{StaticResource PrimaryButton}" Content="אשר טיוטת שלב" IsEnabled="False" Click="Approve_Click"/>
            <TextBlock Text="טיוטה זמנית בלבד · אין שמירה ל־V5" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
