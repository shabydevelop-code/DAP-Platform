<Window x:Class="GuideMe.Instructor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GuideMe Instructor" Height="620" Width="820" MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize" SizeToContent="Manual" ShowInTaskbar="True"
        FlowDirection="LeftToRight"
        Background="#FFF3F6FA" FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#FF18263B"/>
    <SolidColorBrush x:Key="Muted" Color="#FF64748B"/>
    <SolidColorBrush x:Key="Line" Color="#FFE2E8F0"/>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#FFFFFFFF"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="#FFCBD5E1"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="11,9"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#FFF1F5F9"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="#FFD4DEE9"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="15,10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="MinHeight" Value="40"/>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.48"/>
          <Setter Property="Cursor" Value="Arrow"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#FF2458C6"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#FF2458C6"/>
    </Style>
    <Style x:Key="SectionCard" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="20"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Window.Resources>

  <Grid FlowDirection="RightToLeft">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="28,18">
      <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Width="42" Height="42" CornerRadius="12" Background="#FFE8F0FF" Margin="0,0,0,0">
          <TextBlock Text="G" Foreground="#FF2458C6" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
        </Border>
        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="GuideMe Instructor" FontSize="23" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
          <TextBlock Text="סביבת יצירה והקלטת מדריכים" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" Margin="24,22,24,22">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="310"/>
        <ColumnDefinition Width="18"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <Border Style="{StaticResource SectionCard}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="מדריך וחיבור" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="מזהה מדריך" Margin="0,18,0,7" FontWeight="SemiBold" FontSize="12"/>
            <TextBox x:Name="GuideKey" Text="sampleapp-web-instructor" FlowDirection="LeftToRight"/>
            <TextBlock Text="המדריך המקורי לא ישתנה." Style="{StaticResource Hint}" Margin="0,8,0,0"/>
            <Border Height="1" Background="{StaticResource Line}" Margin="0,19,0,16"/>
            <TextBlock Text="חיבור לתוסף Chrome" FontWeight="SemiBold"/>
            <TextBlock Text="העתק את הקוד והזן אותו בתוסף Instructor." Style="{StaticResource Hint}" Margin="0,7,0,10"/>
            <TextBox x:Name="PairingToken" IsReadOnly="True" FlowDirection="LeftToRight" Background="#FFF8FAFC"/>
            <Button Content="העתק קוד חיבור" HorizontalAlignment="Stretch" Margin="0,10,0,0" Click="CopyPairingToken_Click"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource SectionCard}">
          <StackPanel>
            <TextBlock Text="הקלטת שלב" Style="{StaticResource SectionTitle}"/>
            <TextBlock x:Name="StateLabel" Text="מוכן לתחילת שלב 1" FontSize="17" FontWeight="SemiBold" Margin="0,16,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="StatusDetail" Text="טרם הופעל חיבור להקלטת אירועים מהדפדפן." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,17"/>
            <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="התחל שלב" IsEnabled="False" Click="StartStep_Click" HorizontalAlignment="Stretch"/>
            <Button x:Name="EndButton" Content="סיים שלב" Margin="0,9,0,0" IsEnabled="False" Click="EndStep_Click" HorizontalAlignment="Stretch"/>
          </StackPanel>
        </Border>
      </StackPanel>

      <Border Grid.Column="2" Style="{StaticResource SectionCard}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,16">
            <Button x:Name="CopyReviewButton" DockPanel.Dock="Left" Content="העתק סקירה" IsEnabled="False" Click="CopyReview_Click" Padding="11,7" MinHeight="34"/>
            <StackPanel>
              <TextBlock Text="סקירת השלב" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="פעולות שנקלטו והגדרות מוצעות" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
            </StackPanel>
          </DockPanel>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <TextBox x:Name="ReviewText" Text="לאחר סיום שלב יוצגו כאן הפעולות שנקלטו."
                       IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                       VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                       MinHeight="190" Padding="14" Background="#FFF8FAFC" BorderBrush="{StaticResource Line}"/>
              <Expander Header="פרטים טכניים — אבחון בלבד" Margin="0,18,0,0" Foreground="{StaticResource Muted}">
                <StackPanel Margin="0,10,0,0">
                  <TextBlock Text="ContextId" Margin="0,4,0,5" FontSize="12"/>
                  <TextBox x:Name="ContextIdText" IsReadOnly="True" FlowDirection="LeftToRight" IsEnabled="False"/>
                  <TextBlock Text="ContextKind" Margin="0,11,0,5" FontSize="12"/>
                  <TextBox x:Name="ContextKindText" IsReadOnly="True" FlowDirection="LeftToRight" IsEnabled="False"/>
                  <TextBlock Text="ContextValue" Margin="0,11,0,5" FontSize="12"/>
                  <TextBox x:Name="ContextValueText" IsReadOnly="True" FlowDirection="LeftToRight" IsEnabled="False"/>
                </StackPanel>
              </Expander>
              <TextBlock Text="הוראה למשתמש" Style="{StaticResource SectionTitle}" Margin="0,22,0,6"/>
              <TextBlock Text="ערוך את טקסט הבועית שיוצג בזמן הליווי." Style="{StaticResource Hint}" Margin="0,0,0,9"/>
              <TextBox x:Name="BubbleText" Height="100" TextWrapping="Wrap" AcceptsReturn="True"
                       VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" IsEnabled="False"/>
            </StackPanel>
          </ScrollViewer>

          <StackPanel Grid.Row="2" Margin="0,18,0,0">
            <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,16"/>
            <Button x:Name="ApproveButton" Style="{StaticResource PrimaryButton}" Content="אשר טיוטת שלב"
                    IsEnabled="False" Click="Approve_Click" HorizontalAlignment="Stretch"/>
            <TextBlock Text="טיוטה זמנית בלבד · ההקשר טרם אומת · אין שמירה ל־V5"
                       Style="{StaticResource Hint}" Foreground="#FF9A3412" Margin="0,11,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
