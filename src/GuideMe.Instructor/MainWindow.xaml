<Window x:Class="GuideMe.Instructor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GuideMe Instructor" Height="660" Width="920" MinWidth="740" MinHeight="520"
        WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize" SizeToContent="Manual" ShowInTaskbar="True"
        FlowDirection="LeftToRight"
        Background="#FFF3F6FA" FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#FF18263B"/>
    <SolidColorBrush x:Key="Muted" Color="#FF64748B"/>
    <SolidColorBrush x:Key="Line" Color="#FFE2E8F0"/>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#FFFFFFFF"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="#FFCBD5E1"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="11,9"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#FFF1F5F9"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="#FFD4DEE9"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="15,10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="MinHeight" Value="40"/>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.48"/>
          <Setter Property="Cursor" Value="Arrow"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#FF2458C6"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#FF2458C6"/>
    </Style>
    <Style x:Key="SectionCard" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="20"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Window.Resources>

  <Grid FlowDirection="RightToLeft">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="28,18">
      <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Right" Width="42" Height="42" CornerRadius="12" Background="#FFE8F0FF" Margin="0,0,0,0">
          <TextBlock Text="G" Foreground="#FF2458C6" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
        </Border>
        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="GuideMe Instructor" FontSize="23" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
          <TextBlock Text="ניהול לומדות ויצירת שלבים" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" Margin="20,18,20,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border x:Name="StepsSidebar" Grid.Column="0" Style="{StaticResource SectionCard}" Padding="13">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="0"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="0"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="שלבי הלומדה" Style="{StaticResource SectionTitle}"/>
            <TextBlock x:Name="StepCountLabel" Text="טרם נטענה לומדה · 0 שלבים" Style="{StaticResource Hint}" Margin="0,5,0,0"/>
          </StackPanel>
          <TextBox Grid.Row="1" x:Name="StepSearch" Margin="0,14,0,10" Padding="9,8"
                   TextChanged="StepSearch_TextChanged" ToolTip="חיפוש לפי מספר או תוכן שלב"/>
          <ListBox Grid.Row="2" x:Name="StepsList" BorderThickness="0" Background="Transparent"
                   SelectionChanged="StepsList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="4,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Background="#FFE8F0FF" CornerRadius="6" Padding="7,4"
                          Margin="0,0,8,0" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Number}" FontWeight="Bold" Foreground="#FF2458C6"
                               MinWidth="22" TextAlignment="Center" FlowDirection="LeftToRight"/>
                  </Border>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#FF64748B" Margin="0,3,0,0"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource SectionCard}" Padding="16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="0"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="לומדה נוכחית" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ComboBox Grid.Column="0" x:Name="ExistingGuides" DisplayMemberPath="Name" MinHeight="40" Margin="0,0,8,0"/>
              <Button Grid.Column="1" Content="פתח לומדה" Click="LoadExistingGuide_Click" Margin="0,0,8,0"/>
              <Button Grid.Column="2" Content="לומדה חדשה" Click="NewGuide_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
              <Button Grid.Column="3" Content="נקה" Click="ClearWorkspace_Click"/>
            </Grid>
            <TextBlock x:Name="CurrentGuideLabel" Text="לא נבחרה לומדה" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
            <TextBlock x:Name="DatabaseStatus" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
          </StackPanel>
          <Expander Grid.Row="1" Header="חיבור לתוסף הדפדפן" HorizontalAlignment="Right" Margin="0,0,0,12" IsExpanded="False">
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12" MinWidth="340">
              <StackPanel>
                <TextBlock Text="קוד חיבור מקומי" Margin="0,0,0,5"/>
                <TextBox x:Name="PairingToken" IsReadOnly="True" FlowDirection="LeftToRight"/>
                <TextBox x:Name="GuideKey" Visibility="Collapsed"/>
                <Button Content="העתק קוד חיבור" Click="CopyPairingToken_Click" Margin="0,8,0,0" HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>
          </Expander>
          <Border Grid.Row="2" x:Name="NewGuidePanel" Visibility="Collapsed" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="22">
            <StackPanel>
              <TextBlock Text="יצירת לומדה חדשה" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="שם הלומדה" Margin="0,18,0,6"/>
              <TextBox x:Name="NewGuideName" Text="SampleApp Web - Instructor"/>
              <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="צור לומדה" Click="CreateGuide_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                <Button Content="ביטול" Click="CancelNewGuide_Click"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <TabControl Grid.Row="2" x:Name="WorkspaceTabs" BorderBrush="{StaticResource Line}" Background="White">
            <TabItem Header="הגדרות לומדה">
              <TabControl x:Name="GuideSettingsTabs" Background="White" BorderBrush="{StaticResource Line}">
            <TabItem Header="לומדות"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Text="Guides · קריאה בלבד" FontFamily="Consolas" FontSize="12" FlowDirection="LeftToRight"/><TextBox x:Name="GuideDetails" Text="לא נטענה לומדה." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="12" Margin="0,12,0,0" MinHeight="130"/></StackPanel></ScrollViewer></TabItem>
            <TabItem Header="הקשרי אפליקציה"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Text="ApplicationContexts · קריאה בלבד" FontFamily="Consolas" FontSize="12" FlowDirection="LeftToRight"/><TextBox x:Name="ContextsDetails" Text="לא נטען מדריך." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="12" Margin="0,12,0,0" MinHeight="130"/></StackPanel></ScrollViewer></TabItem>
              </TabControl>
            </TabItem>
            <TabItem Header="עריכת שלבים">
              <TabControl x:Name="StepDetailsTabs" Background="White" BorderBrush="{StaticResource Line}">
            <TabItem Header="שלבים"><DockPanel LastChildFill="True"><StackPanel DockPanel.Dock="Top">          <Border Background="#FFF4F7FC" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock x:Name="StateLabel" Text="מוכן לתחילת שלב 1" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="StatusDetail" Text="יש לחבר את התוסף כדי להתחיל." Style="{StaticResource Hint}" Margin="0,5,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="התחל שלב" IsEnabled="False" Click="StartStep_Click" Padding="10,7" Margin="0,0,7,0"/>
                <Button x:Name="EndButton" Content="סיים שלב" IsEnabled="False" Click="EndStep_Click" Padding="10,7"/>
              </StackPanel>
            </Grid>
          </Border>
</StackPanel><StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0"><Button x:Name="ApproveButton" Style="{StaticResource PrimaryButton}" Content="אשר טיוטת שלב" IsEnabled="False" Click="Approve_Click"/><TextBlock Text="טיוטה זמנית בלבד · אין שמירה ל־V5" Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Text="Steps · קריאה בלבד" FontFamily="Consolas" FontSize="12" FlowDirection="LeftToRight"/><TextBlock x:Name="DraftBubbleHeading" Text="הוראה למשתמש — טיוטת הקלטה" Style="{StaticResource SectionTitle}" Margin="0,10,0,5" Visibility="Collapsed"/><TextBox x:Name="BubbleText" Height="70" TextWrapping="Wrap" AcceptsReturn="True" IsEnabled="False" Visibility="Collapsed"/><TextBox x:Name="BubbleDetails" Text="לא נטען מדריך." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="12" Margin="0,12,0,0" MinHeight="130"/>              <StackPanel x:Name="CaptureReviewPanel" Visibility="Collapsed" Margin="0,18,0,0">
                <TextBlock Text="סקירת הקלטת שלב — טיוטה בלבד" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                <DockPanel LastChildFill="True">
                  <Button x:Name="CopyReviewButton" DockPanel.Dock="Left" Content="העתק סקירה" IsEnabled="False" Click="CopyReview_Click" Padding="9,5" MinHeight="30"/>
                  <TextBlock x:Name="ReviewHeading" Text="סקירת השלב" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBox x:Name="ReviewText" Text="בחר שלב מהרשימה או הקלט שלב חדש."
                         IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         MinHeight="140" Padding="11" Margin="0,9,0,0" Background="#FFF8FAFC"/>
                <TextBlock Text="הקשר מסך מוצע — טרם אומת" FontWeight="SemiBold" Margin="0,14,0,12"/>
                <TextBlock Text="ContextId" FontSize="11"/>
                <TextBox x:Name="ContextIdText" IsReadOnly="True" FlowDirection="LeftToRight" IsEnabled="False"/>
                <TextBlock Text="ContextKind" FontSize="11" Margin="0,9,0,0"/>
                <TextBox x:Name="ContextKindText" IsReadOnly="True" FlowDirection="LeftToRight" IsEnabled="False"/>
                <TextBlock Text="ContextValue" FontSize="11" Margin="0,9,0,0"/>
                <TextBox x:Name="ContextValueText" IsReadOnly="True" FlowDirection="LeftToRight" IsEnabled="False"/>
              </StackPanel></StackPanel></ScrollViewer></DockPanel></TabItem>
            <TabItem Header="רכיבים"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Text="Elements · קריאה בלבד" FontFamily="Consolas" FontSize="12" FlowDirection="LeftToRight"/><TextBox x:Name="ElementDetails" Text="לא נטען מדריך." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="12" Margin="0,12,0,0" MinHeight="130"/></StackPanel></ScrollViewer></TabItem>
            <TabItem Header="עוגנים"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Text="ElementAnchors · קריאה בלבד" FontFamily="Consolas" FontSize="12" FlowDirection="LeftToRight"/><TextBox x:Name="AnchorsDetails" Text="לא נטען מדריך." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="12" Margin="0,12,0,0" MinHeight="130"/></StackPanel></ScrollViewer></TabItem>
            <TabItem Header="יעדי שלבים"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Text="StepTargets · קריאה בלבד" FontFamily="Consolas" FontSize="12" FlowDirection="LeftToRight"/><TextBox x:Name="InteractionDetails" Text="לא נטען מדריך." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="12" Margin="0,12,0,0" MinHeight="130"/></StackPanel></ScrollViewer></TabItem>
            <TabItem Header="כללי שלבים"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><TextBlock Text="StepRules · קריאה בלבד" FontFamily="Consolas" FontSize="12" FlowDirection="LeftToRight"/><TextBox x:Name="RulesDetails" Text="לא נטען מדריך." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="12" Margin="0,12,0,0" MinHeight="130"/></StackPanel></ScrollViewer></TabItem>
              </TabControl>
            </TabItem>
          </TabControl>

        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
