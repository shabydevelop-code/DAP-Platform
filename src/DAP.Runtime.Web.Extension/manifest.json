{
  "manifest_version": 3,
  "name": "DAP Web Runtime",
  "version": "0.2.1",
  "description": "DAP browser-native Web learner runtime and extension-native E2E driver.",
  "permissions": [
    "storage",
    "nativeMessaging",
    "tabs",
    "webNavigation",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost/*",
    "https://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "https://localhost/*"
      ],
      "js": [
        "content-runtime.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
