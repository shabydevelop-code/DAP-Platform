{
  "manifest_version": 3,
  "name": "GuideMe Instructor",
  "version": "0.3.3",
  "description": "Headless background capture for GuideMe Web Instructor.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://127.0.0.1:53922/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "key": "",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
