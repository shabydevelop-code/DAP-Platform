<Window x:Class="DAP.TestCRM.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="DAP Test CRM - Windows" Height="760" Width="1120" MinHeight="620" MinWidth="900"
 AutomationProperties.AutomationId="TestCrmMainWindow" FlowDirection="RightToLeft">
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,10">
   <Button x:Name="PortalButton" AutomationProperties.AutomationId="PortalHeader" Content="DAP Test CRM" FontSize="22" FontWeight="SemiBold" BorderThickness="0" Background="Transparent" Click="PortalButton_Click"/>
   <TextBlock Text="מערכת יעד לבדיקות DAP" VerticalAlignment="Center" Margin="14,0,0,0"/>
  </DockPanel>
  <StackPanel Grid.Row="1" x:Name="BreadcrumbPanel" Orientation="Horizontal" Margin="0,0,0,12"/>
  <ContentControl Grid.Row="2" x:Name="ScreenHost" AutomationProperties.AutomationId="ScreenHost" HorizontalContentAlignment="Right" VerticalContentAlignment="Top" FlowDirection="RightToLeft"/>
  <TextBlock Grid.Row="3" x:Name="StatusText" AutomationProperties.AutomationId="StatusText" Margin="0,10,0,0"/>
 </Grid>
</Window>