<Window x:Class="DAP.TestCRM.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="DAP Test CRM - Windows" Height="760" Width="1120" MinHeight="620" MinWidth="900"
 AutomationProperties.AutomationId="TestCrmMainWindow" FlowDirection="RightToLeft"
 Background="#EEF1F5" FontFamily="Segoe UI" FontSize="13">
 <Window.Resources>
  <SolidColorBrush x:Key="PrimaryBlue" Color="#285D88"/>
  <SolidColorBrush x:Key="HeaderBlue" Color="#214666"/>
  <SolidColorBrush x:Key="HeadingBlue" Color="#234D72"/>
  <SolidColorBrush x:Key="BorderBrush" Color="#AEB8C2"/>
  <SolidColorBrush x:Key="LightBorderBrush" Color="#C2CAD1"/>

  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#172B3D"/>
   <Setter Property="Background" Value="#F4F6F8"/>
   <Setter Property="BorderBrush" Value="#7D8D9C"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="12,5"/>
   <Setter Property="MinHeight" Value="29"/>
   <Setter Property="Margin" Value="3"/>
  </Style>

  <Style TargetType="TextBox">
   <Setter Property="Background" Value="White"/>
   <Setter Property="Foreground" Value="#111111"/>
   <Setter Property="BorderBrush" Value="#8D9AA5"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="6,5"/>
   <Setter Property="MinHeight" Value="29"/>
   <Setter Property="Margin" Value="3"/>
  </Style>

  <Style TargetType="ComboBox">
   <Setter Property="Background" Value="White"/>
   <Setter Property="Foreground" Value="#111111"/>
   <Setter Property="BorderBrush" Value="#8D9AA5"/>
   <Setter Property="Padding" Value="5,3"/>
   <Setter Property="MinHeight" Value="29"/>
   <Setter Property="Margin" Value="3"/>
  </Style>

  <Style TargetType="DataGrid">
   <Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="#9DAAB6"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="GridLinesVisibility" Value="All"/>
   <Setter Property="HorizontalGridLinesBrush" Value="#C2CAD1"/>
   <Setter Property="VerticalGridLinesBrush" Value="#C2CAD1"/>
   <Setter Property="RowBackground" Value="White"/>
   <Setter Property="AlternatingRowBackground" Value="#F6F8FA"/>
   <Setter Property="HeadersVisibility" Value="Column"/>
   <Setter Property="RowHeight" Value="30"/>
   <Setter Property="ColumnHeaderHeight" Value="30"/>
   <Setter Property="Margin" Value="0,6,0,8"/>
  </Style>

  <Style TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="#DCE3E9"/>
   <Setter Property="Foreground" Value="#253D51"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="BorderBrush" Value="#AAB5BF"/>
   <Setter Property="BorderThickness" Value="0,0,1,1"/>
   <Setter Property="Padding" Value="8,5"/>
   <Setter Property="HorizontalContentAlignment" Value="Right"/>
  </Style>

  <Style TargetType="TabControl">
   <Setter Property="Background" Value="White"/>
   <Setter Property="BorderBrush" Value="#8FA1B2"/>
   <Setter Property="Margin" Value="0,8,0,8"/>
  </Style>

  <Style TargetType="TabItem">
   <Setter Property="Foreground" Value="#234D72"/>
   <Setter Property="Background" Value="#E4E9EE"/>
   <Setter Property="BorderBrush" Value="#9AA8B5"/>
   <Setter Property="Padding" Value="15,6"/>
   <Setter Property="Margin" Value="1,0,0,0"/>
  </Style>

  <Style TargetType="Label">
   <Setter Property="Foreground" Value="#333333"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Padding" Value="3,4"/>
  </Style>
 </Window.Resources>

 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="52"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <Border Grid.Row="0" Background="#214666" BorderBrush="#16354F" BorderThickness="0,0,0,1">
   <DockPanel Margin="22,0">
    <Button x:Name="PortalButton"
            AutomationProperties.AutomationId="PortalHeader"
            Content="DAP Test CRM"
            FontSize="18"
            FontWeight="Normal"
            Foreground="White"
            BorderThickness="0"
            Background="Transparent"
            Padding="0"
            Margin="0"
            Click="PortalButton_Click"/>
    <TextBlock Text="מערכת יעד לבדיקות DAP"
               Foreground="#E5EDF4"
               FontSize="12"
               VerticalAlignment="Center"
               Margin="22,0,0,0"/>
   </DockPanel>
  </Border>

  <Grid Grid.Row="1" Margin="14">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
   </Grid.RowDefinitions>

   <Border Grid.Row="0"
           Background="#DCE4EB"
           BorderBrush="#AEB9C3"
           BorderThickness="1"
           Padding="9,6"
           Margin="0,0,0,8">
    <StackPanel x:Name="BreadcrumbPanel" Orientation="Horizontal"/>
   </Border>

   <Border Grid.Row="1"
           Background="White"
           BorderBrush="#AEB8C2"
           BorderThickness="1"
           Padding="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
     <ContentControl x:Name="ScreenHost"
                     AutomationProperties.AutomationId="ScreenHost"
                     HorizontalContentAlignment="Stretch"
                     VerticalContentAlignment="Top"
                     FlowDirection="RightToLeft"/>
    </ScrollViewer>
   </Border>
  </Grid>

  <Border Grid.Row="2"
          Background="#F6F8FA"
          BorderBrush="#C2CAD1"
          BorderThickness="0,1,0,0"
          Padding="14,7">
   <TextBlock x:Name="StatusText"
              AutomationProperties.AutomationId="StatusText"
              Foreground="#65727D"/>
  </Border>
 </Grid>
</Window>
