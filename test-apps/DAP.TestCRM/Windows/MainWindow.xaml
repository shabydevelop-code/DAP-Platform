<Window x:Class="DAP.TestCRM.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DAP Test CRM - Windows" Height="760" Width="1180"
        MinHeight="620" MinWidth="980"
        AutomationProperties.AutomationId="TestCrmMainWindow">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <TextBlock Text="DAP Test CRM" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button x:Name="RefreshButton" AutomationProperties.AutomationId="RefreshButton"
                    Content="רענון" Width="90" Height="32" DockPanel.Dock="Right" Click="RefreshButton_Click"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="לקוחות" Margin="0,0,10,0">
                <DataGrid x:Name="CustomersGrid" AutomationProperties.AutomationId="CustomersGrid"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          SelectionChanged="CustomersGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="מספר" Binding="{Binding Id}" Width="70"/>
                        <DataGridTextColumn Header="שם" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="טלפון" Binding="{Binding Phone}" Width="130"/>
                        <DataGridTextColumn Header="דוא&quot;ל" Binding="{Binding Email}" Width="190"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <TabControl Grid.Column="1" x:Name="DetailsTabs" AutomationProperties.AutomationId="DetailsTabs">
                <TabItem Header="אתרים" AutomationProperties.AutomationId="SitesTab">
                    <Grid Margin="8">
                        <Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DataGrid x:Name="SitesGrid" AutomationProperties.AutomationId="SitesGrid" AutoGenerateColumns="False"
                                  IsReadOnly="True" SelectionMode="Single" SelectionChanged="SitesGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="מספר" Binding="{Binding Id}" Width="65"/>
                                <DataGridTextColumn Header="שם" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="סוג" Binding="{Binding Type}" Width="110"/>
                                <DataGridTextColumn Header="כתובת" Binding="{Binding Address}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Grid.Row="1" Margin="0,10,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="SiteNameBox" AutomationProperties.AutomationId="SiteName" Margin="0,0,6,0"/>
                            <ComboBox x:Name="SiteTypeBox" AutomationProperties.AutomationId="SiteType" Grid.Column="1" Margin="0,0,6,0">
                                <ComboBoxItem Content="משרד"/><ComboBoxItem Content="סניף"/><ComboBoxItem Content="מחסן"/>
                            </ComboBox>
                            <TextBox x:Name="SiteAddressBox" AutomationProperties.AutomationId="SiteAddress" Grid.Column="2"/>
                        </Grid>
                        <Button Grid.Row="2" x:Name="SaveSiteButton" AutomationProperties.AutomationId="SaveSiteButton"
                                Content="שמור אתר" Width="110" HorizontalAlignment="Right" Click="SaveSiteButton_Click"/>
                    </Grid>
                </TabItem>

                <TabItem Header="פניות" AutomationProperties.AutomationId="CasesTab">
                    <Grid Margin="8">
                        <Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DataGrid x:Name="CasesGrid" AutomationProperties.AutomationId="CasesGrid" AutoGenerateColumns="False"
                                  IsReadOnly="True" SelectionMode="Single" SelectionChanged="CasesGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="מספר" Binding="{Binding Id}" Width="65"/>
                                <DataGridTextColumn Header="סטטוס" Binding="{Binding Status}" Width="110"/>
                                <DataGridTextColumn Header="נושא" Binding="{Binding Subject}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="1" Margin="0,10,0,8">
                            <ComboBox x:Name="CaseStatusBox" AutomationProperties.AutomationId="CaseStatus" Margin="0,0,0,6">
                                <ComboBoxItem Content="פתוחה"/><ComboBoxItem Content="בטיפול"/><ComboBoxItem Content="סגורה"/>
                            </ComboBox>
                            <TextBox x:Name="CaseSubjectBox" AutomationProperties.AutomationId="CaseSubject" Margin="0,0,0,6"/>
                            <TextBox x:Name="CaseDescriptionBox" AutomationProperties.AutomationId="CaseDescription" Height="55" AcceptsReturn="True" Margin="0,0,0,6"/>
                            <TextBox x:Name="CaseCloseReasonBox" AutomationProperties.AutomationId="CaseCloseReason"/>
                        </StackPanel>
                        <Button Grid.Row="2" x:Name="SaveCaseButton" AutomationProperties.AutomationId="SaveCaseButton"
                                Content="שמור פנייה" Width="110" HorizontalAlignment="Right" Click="SaveCaseButton_Click"/>
                    </Grid>
                </TabItem>

                <TabItem Header="לידים" AutomationProperties.AutomationId="LeadsTab">
                    <Grid Margin="8">
                        <Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DataGrid x:Name="LeadsGrid" AutomationProperties.AutomationId="LeadsGrid" AutoGenerateColumns="False"
                                  IsReadOnly="True" SelectionMode="Single" SelectionChanged="LeadsGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="מספר" Binding="{Binding Id}" Width="65"/>
                                <DataGridTextColumn Header="מקור" Binding="{Binding Source}" Width="120"/>
                                <DataGridTextColumn Header="איש קשר" Binding="{Binding ContactName}" Width="*"/>
                                <DataGridTextColumn Header="סטטוס" Binding="{Binding Status}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Grid.Row="1" Margin="0,10,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="LeadSourceBox" AutomationProperties.AutomationId="LeadSource" Margin="0,0,6,6">
                                <ComboBoxItem Content="אתר אינטרנט"/><ComboBoxItem Content="הפניה"/><ComboBoxItem Content="קמפיין"/><ComboBoxItem Content="טלפון"/>
                            </ComboBox>
                            <TextBox x:Name="LeadContactBox" AutomationProperties.AutomationId="LeadContactName" Grid.Column="1" Margin="0,0,6,6"/>
                            <ComboBox x:Name="LeadStatusBox" AutomationProperties.AutomationId="LeadStatus" Grid.Column="2" Margin="0,0,0,6">
                                <ComboBoxItem Content="חדש"/><ComboBoxItem Content="בתהליך"/><ComboBoxItem Content="נסגר בהצלחה"/><ComboBoxItem Content="נסגר ללא עסקה"/>
                            </ComboBox>
                            <TextBox x:Name="LeadNotesBox" AutomationProperties.AutomationId="LeadNotes" Grid.Row="1" Grid.ColumnSpan="3" Height="45" AcceptsReturn="True" Margin="0,0,0,6"/>
                            <TextBox x:Name="LeadSelectedServiceBox" AutomationProperties.AutomationId="LeadSelectedService" Grid.Row="2" Grid.ColumnSpan="3" Margin="0,0,0,6"/>
                            <TextBox x:Name="LeadLostReasonBox" AutomationProperties.AutomationId="LeadLostReason" Grid.Row="3" Grid.ColumnSpan="3"/>
                        </Grid>
                        <Button Grid.Row="2" x:Name="SaveLeadButton" AutomationProperties.AutomationId="SaveLeadButton"
                                Content="שמור ליד" Width="110" HorizontalAlignment="Right" Click="SaveLeadButton_Click"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <TextBlock Grid.Row="2" x:Name="StatusText" AutomationProperties.AutomationId="StatusText"
                   Margin="0,10,0,0" Text="מתחבר לשרת..." />
    </Grid>
</Window>
